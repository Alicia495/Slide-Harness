# 社内LANのホストIPを指定できます。0.0.0.0 はすべてのホストインターフェースで待ち受けます。
BIND_HOST=0.0.0.0
APP_PORT=3000
DB_PASSWORD=change-this-password
# AI設定画面で API キーを登録する場合に必要。32バイトの乱数をBase64で指定します。
AI_SETTINGS_ENCRYPTION_KEY=

# Azure OpenAI: RESOURCE と DEPLOYMENT と API_KEY を設定してください。
AZURE_OPENAI_RESOURCE=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_LEGACY_URLS=false
# Azure 側から文脈長を取得できない場合だけ指定します。
AZURE_OPENAI_CONTEXT_WINDOW=

# vLLM: OpenAI互換 API の /v1 まで含めた URL とモデル ID を指定してください。
# Docker Desktop 上のホストで OpenAI 互換サーバーを起動する場合の例: http://host.docker.internal:8888/v1
VLLM_BASE_URL=
VLLM_MODEL=
# 認証が必要なサーバーだけ設定します。空欄なら Authorization ヘッダーを送りません。
VLLM_API_KEY=
VLLM_CONTEXT_WINDOW=

# 外部 AI を設定せず画面を試すときだけ true にします。
DEMO_AI=false
