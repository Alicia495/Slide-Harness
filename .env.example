# 既定は 127.0.0.1 のローカルのみ。社内LANで公開する場合はホストIPを指定します。0.0.0.0 はすべてのホストインターフェースで待ち受けます。
BIND_HOST=127.0.0.1
APP_PORT=3000
# 必須。DATABASE_URL に埋め込むため、英数字のみを使用してください。@ : / ? # などのURL予約文字は接続文字列を壊します。
DB_PASSWORD=change-this-password
# AI設定画面で API キーを登録する場合に必要。32バイトの乱数をBase64で指定します。
AI_SETTINGS_ENCRYPTION_KEY=
# 既存資料の編集を read/edit/write/render/inspect ツールの反復実行へ切り替えます。無効時と空資料の初回生成は従来経路を使います。
AI_TOOL_LOOP_ENABLED=true

# Azure OpenAI: RESOURCE と DEPLOYMENT と API_KEY を設定してください。
AZURE_OPENAI_RESOURCE=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_LEGACY_URLS=false
# Azure 側から文脈長を取得できない場合だけ指定します。
AZURE_OPENAI_CONTEXT_WINDOW=

# vLLM: OpenAI互換 API の /v1 まで含めた URL とモデル ID を指定してください。
# Docker Desktop 上のホストで OpenAI 互換サーバーを起動する場合の例: http://host.docker.internal:8888/v1
VLLM_BASE_URL=
VLLM_MODEL=
# 認証が必要なサーバーだけ設定します。空欄なら Authorization ヘッダーを送りません。
VLLM_API_KEY=
VLLM_CONTEXT_WINDOW=

# 外部 AI を設定せず画面を試すときだけ true にします。
DEMO_AI=false
